# Local-only placeholders. Copy to .env and replace BOTH password placeholders.
# Do not place actual credentials in this example or any NEXT_PUBLIC_ variable.
DATABASE_URL="postgresql://platform:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/platform?schema=public"

# Used by the optional local Compose service. Must match DATABASE_URL.
POSTGRES_PASSWORD="REPLACE_WITH_LOCAL_PASSWORD"

# No public environment variables or payment-provider credentials are needed.
